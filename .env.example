# Copy this file to .env.local and fill in the values.
# Supabase Dashboard → your project → "Connect" → Framework → Expo React Native.
# The publishable key is meant to live inside the app (it's not a secret);
# never put the "secret" / "service_role" key here.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
